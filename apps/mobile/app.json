{
  "expo": {
    "name": "VerifiedDoc",
    "slug": "verifieddoc",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "verifieddoc",
    "splash": {
      "backgroundColor": "#F7F3EA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.verifieddocteam.verifieddoc"
    },
    "android": {
      "package": "com.verifieddocteam.verifieddoc",
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "backgroundColor": "#F7F3EA"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow VerifiedDoc to scan credential verification QR codes."
        }
      ],
      "expo-secure-store"
    ]
  }
}
