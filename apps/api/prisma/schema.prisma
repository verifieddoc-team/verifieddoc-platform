generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  HOLDER
  VERIFIER
  PLATFORM_ADMIN
}

enum OrganizationRole {
  ORGANIZATION_ADMIN
  ORGANIZATION_ISSUER
}

enum OrganizationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum CredentialStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           PlatformRole         @default(HOLDER)
  memberships    OrganizationMember[]
  credentials    Credential[]         @relation("CredentialHolder")
  issued          Credential[]         @relation("CredentialIssuer")
  shareLinks      ShareLink[]
  auditLogs       AuditLog[]           @relation("AuditActor")
  refreshTokens  RefreshToken[]
  reviewedOrganizations Organization[] @relation("OrganizationReviewer")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model RefreshToken {
  id                String         @id @default(cuid())
  tokenHash         String         @unique
  userId            String
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime       @default(now())
  userAgent         String?
  ipAddress         String?
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy        RefreshToken?  @relation("TokenReplacement", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replacedTokens    RefreshToken[] @relation("TokenReplacement")

  @@index([userId, revokedAt])
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Organization {
  id                 String               @id @default(cuid())
  name               String
  slug               String               @unique
  emailDomain        String?
  registrationNumber String?
  website            String?
  contactEmail       String
  country            String
  description        String?
  rejectionReason    String?
  reviewedAt         DateTime?
  reviewedById       String?
  status             OrganizationStatus   @default(PENDING)
  members            OrganizationMember[]
  credentials        Credential[]
  reviewedBy         User?                @relation("OrganizationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([contactEmail])
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())

  @@unique([organizationId, userId])
}

model Credential {
  id             String           @id @default(cuid())
  publicId       String           @unique @default(cuid())
  title          String
  description    String?
  credentialType String
  referenceNo    String
  status         CredentialStatus @default(ACTIVE)
  issuedAt       DateTime
  expiresAt      DateTime?
  revokedAt      DateTime?
  revocationNote String?
  metadata       Json?
  organizationId String
  holderId       String
  issuedById     String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  holder         User             @relation("CredentialHolder", fields: [holderId], references: [id])
  issuedBy       User             @relation("CredentialIssuer", fields: [issuedById], references: [id])
  shareLinks     ShareLink[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, referenceNo])
  @@index([holderId, status])
}

model ShareLink {
  id           String     @id @default(cuid())
  tokenHash    String     @unique
  credentialId String
  createdById  String
  expiresAt    DateTime
  revokedAt    DateTime?
  maxViews     Int?
  viewCount    Int        @default(0)
  credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  createdBy    User       @relation(fields: [createdById], references: [id])
  createdAt    DateTime   @default(now())
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  details      Json?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id])
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([actorId, createdAt])
}
