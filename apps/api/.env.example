NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://verifieddoc:verifieddoc@localhost:5432/verifieddoc?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
PUBLIC_WEB_URL=http://localhost:3000
ALLOW_ADMIN_BOOTSTRAP=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=

# API tests use a dedicated database and ignore this .env file.
# See apps/api/.env.test.example and set TEST_DATABASE_URL there if needed.
# Default test database: postgresql://verifieddoc:verifieddoc@localhost:5432/verifieddoc_test?schema=public
