# Optional local overrides for API tests.
# Copy to apps/api/.env.test if needed. Never commit apps/api/.env.test.
#
# Tests intentionally ignore apps/api/.env so development DATABASE_URL values
# (including remote Supabase URLs) cannot leak into the test suite.
#
# Preferred local database: docker compose postgres service + verifieddoc_test

TEST_DATABASE_URL=postgresql://verifieddoc:verifieddoc@localhost:5432/verifieddoc_test?schema=public
